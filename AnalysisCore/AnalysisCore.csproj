<Project Sdk="Microsoft.NET.Sdk">

  <!-- 音频分析纯层自检工程：net9.0 控制台，零外部包依赖。
       通过 Compile Include 把 Assets/Scripts/Pure 下全部纯 C# 代码链接进来，
       与 Unity 共用同一份源码（严禁引用 UnityEngine）。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>AnalysisCore</AssemblyName>
    <RootNamespace>AnalysisCore</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Assets/Scripts/Pure/**/*.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
